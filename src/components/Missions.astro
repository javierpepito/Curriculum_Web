---
import { cvData } from '../data/cvData';
import MoonPlanet from './MoonPlanet.astro';
---

<section class="missions-section" id="misiones">
  <!-- Moon Planet (ship orbits this) -->
  <MoonPlanet />
  
  <div class="site-container">
    <!-- Section Header matching Image 3 & 5 -->
    <div class="section-header">
      <span class="badge-pink">BITÁCORA DE OPERACIONES</span>
      <div class="section-title-wrap">
        <span class="section-number">02</span>
        <h2 class="section-title">MISIONES REALIZADAS</h2>
        <div class="section-line"></div>
      </div>
    </div>

    <div class="projects-showcase cyber-card">
      <div class="showcase-decor-corner-tr"></div>
      
      <div class="showcase-top-bar">
        <span class="showcase-badge">
          <span class="status-pulse-dot"></span>
          ARCHIVO // REGISTRO DE MISIONES
        </span>
        <span class="showcase-status-code">DESBLOQUEADAS</span>
      </div>

      <div class="showcase-content">
        <h3 class="showcase-title">
          <span class="pixel-solid-shadow">VER PROYECTOS</span>
        </h3>
        <p class="showcase-desc">
          Explora el registro completo de proyectos técnicos, arquitecturas construidas y soluciones interactivas desarrolladas a lo largo de mi formación.
        </p>

        <div class="showcase-categories-preview">
          <span class="preview-tag"><span class="tag-num">01</span> IOT</span>
          <span class="preview-tag"><span class="tag-num">02</span> DESARROLLO WEB</span>
          <span class="preview-tag"><span class="tag-num">03</span> APPS MÓVILES</span>
          <span class="preview-tag"><span class="tag-num">04</span> DATA SCIENCE</span>
        </div>

        <div class="showcase-btn-wrap">
          <a href="/proyectos" class="btn-cyber-cyan btn-showcase-action">
            <span>IR</span>
            <span class="btn-arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .missions-section {
    padding: 4.5rem 0 5rem;
    position: relative;
    overflow: visible;
  }

  .projects-showcase {
    position: relative;
    min-height: 220px;
    margin: 1.5rem 0 3rem 210px;
    padding: 2.25rem 2.5rem;
    background: linear-gradient(145deg, rgba(13, 20, 48, 0.9) 0%, rgba(9, 14, 36, 0.95) 100%);
    border: 1px solid rgba(0, 240, 255, 0.4);
    box-shadow: 
      8px 8px 0px rgba(77, 16, 90, 0.45),
      0 0 30px rgba(0, 240, 255, 0.08);
    backdrop-filter: blur(10px);
  }

  .showcase-decor-corner-tr {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 14px;
    height: 14px;
    border-top: 2px solid var(--pink-neon);
    border-right: 2px solid var(--pink-neon);
    pointer-events: none;
  }

  .showcase-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed rgba(24, 37, 76, 0.9);
  }

  .showcase-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--cyan-neon);
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    letter-spacing: 1px;
  }

  .status-pulse-dot {
    width: 7px;
    height: 7px;
    background: var(--cyan-neon);
    box-shadow: 0 0 8px var(--cyan-neon);
    animation: blink 1.2s infinite;
  }

  .showcase-status-code {
    font-family: var(--font-pixel);
    font-size: 0.58rem;
    color: var(--pink-neon);
    letter-spacing: 1px;
  }

  .showcase-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .showcase-title {
    font-family: var(--font-pixel);
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    margin-bottom: 0.85rem;
    color: #ffffff;
  }

  .showcase-desc {
    max-width: 720px;
    color: #9cb1ce;
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .showcase-categories-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .preview-tag {
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    color: #cbd5e1;
    background: rgba(13, 20, 48, 0.8);
    border: 1px solid rgba(0, 240, 255, 0.25);
    padding: 0.4rem 0.75rem;
    letter-spacing: 0.5px;
  }

  .tag-num {
    color: var(--pink-neon);
    margin-right: 0.25rem;
  }

  .showcase-btn-wrap {
    display: flex;
    align-items: center;
  }

  .btn-showcase-action {
    padding: 0.9rem 1.6rem;
    font-size: 0.82rem;
    background: rgba(0, 240, 255, 0.12);
    border: 1px solid var(--cyan-neon);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.25);
  }

  .btn-showcase-action:hover {
    background: var(--cyan-neon);
    color: var(--bg-space);
    box-shadow: 0 0 25px rgba(0, 240, 255, 0.65);
    transform: translateY(-2px);
  }

  @media (max-width: 1100px) {
    .projects-showcase {
      margin-left: 0;
      padding: 2rem 1.5rem;
    }
  }

  .missions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem;
  }

  /* Mission Card Styling */
  .mission-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: #090e24;
    cursor: pointer;
  }

  .mission-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .mission-number-tag {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--cyan-neon);
    letter-spacing: 1px;
  }

  .mission-status-tag {
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    color: var(--cyan-neon);
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .status-box {
    color: var(--cyan-neon);
    font-size: 0.75rem;
  }

  /* 3D Wireframe Visual Box */
  .mission-visual-box {
    position: relative;
    width: 100%;
    height: 190px;
    background: #050816;
    border: 1px solid #142042;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .wireframe-plane {
    position: absolute;
    bottom: -35px;
    left: -20%;
    width: 140%;
    height: 160px;
    background-image: 
      linear-gradient(rgba(0, 240, 255, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 240, 255, 0.22) 1px, transparent 1px);
    background-size: 24px 24px;
    transform: perspective(200px) rotateX(60deg);
    transform-origin: bottom center;
    mask-image: linear-gradient(to top, rgba(0,0,0,1) 40%, rgba(0,0,0,0) 100%);
    -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 40%, rgba(0,0,0,0) 100%);
  }

  .graphic-element {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .mission-card:hover .graphic-element {
    transform: scale(1.05);
  }

  /* 1. IoT Graphic */
  :global(.circuit-board) {
    position: relative;
    width: 140px;
    height: 75px;
    background: #08112c;
    border: 1.5px solid var(--cyan-neon);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.25);
  }

  :global(.chip-core) {
    width: 44px;
    height: 38px;
    background: #040816;
    border: 1.5px solid var(--cyan-neon);
  }

  :global(.circuit-wire) {
    position: absolute;
    height: 2px;
  }

  :global(.wire-left) {
    left: 8px;
    width: 38px;
    background: var(--yellow-accent);
  }

  :global(.wire-right) {
    right: 8px;
    width: 38px;
    background: var(--yellow-accent);
  }

  :global(.node) {
    position: absolute;
    width: 8px;
    height: 8px;
  }

  :global(.pink-node) {
    background: var(--pink-neon);
    box-shadow: 0 0 8px var(--pink-neon);
    left: 0;
    top: -3px;
  }

  :global(.cyan-node) {
    background: var(--cyan-neon);
    box-shadow: 0 0 8px var(--cyan-neon);
    right: 0;
    top: -3px;
  }

  :global(.floating-node-1) {
    position: absolute;
    top: 10px;
    right: 18px;
    background: var(--cyan-neon);
    box-shadow: 0 0 8px var(--cyan-neon);
  }

  /* 2. Web Browser Mockup */
  :global(.browser-mockup) {
    position: relative;
    width: 150px;
    height: 90px;
    background: #111738;
    border: 1.5px solid #233266;
    box-shadow: 4px 4px 0px rgba(0,0,0,0.4);
  }

  :global(.browser-bar) {
    display: flex;
    gap: 4px;
    padding: 4px 6px;
    background: #0a0e24;
    border-bottom: 1px solid #1c2754;
  }

  :global(.bar-dot) {
    width: 6px;
    height: 6px;
  }
  :global(.pink-dot) { background: var(--pink-neon); }
  :global(.yellow-dot) { background: var(--yellow-accent); }

  :global(.browser-content) {
    padding: 10px;
    position: relative;
  }

  :global(.content-block-left) {
    width: 38px;
    height: 38px;
    background: #53388f;
    box-shadow: 2px 2px 0px #241646;
    display: inline-block;
  }

  :global(.content-block-cyan) {
    position: absolute;
    left: 36px;
    top: 26px;
    width: 22px;
    height: 22px;
    background: var(--cyan-neon);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.4);
  }

  :global(.content-lines) {
    position: absolute;
    right: 12px;
    top: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.line-mock) {
    width: 44px;
    height: 4px;
    background: #2b396e;
  }
  :global(.line-mock.short) {
    width: 30px;
  }

  /* 3. Space / Mobile radar */
  :global(.space-field) {
    position: relative;
    width: 170px;
    height: 85px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  :global(.space-ship-cursor) {
    width: 0;
    height: 0;
    border-left: 12px solid var(--cyan-neon);
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    filter: drop-shadow(0 0 6px var(--cyan-neon));
    transform: rotate(20deg);
  }

  :global(.trajectory-line) {
    flex: 1;
    height: 1px;
    border-top: 1.5px dashed rgba(0, 240, 255, 0.45);
    margin: 0 10px;
  }

  :global(.target-planet) {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #9933cc;
    box-shadow: 0 0 15px rgba(255, 0, 127, 0.6);
  }

  /* 4. Data Chart Graphic */
  :global(.chart-container) {
    position: relative;
    width: 160px;
    height: 90px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  :global(.chart-line-trend) {
    position: absolute;
    top: 12px;
    left: 5px;
    width: 110px;
    height: 2px;
    background: var(--cyan-neon);
    box-shadow: 0 0 10px var(--cyan-neon);
    transform: rotate(-16deg);
    transform-origin: left bottom;
  }

  :global(.chart-bars) {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    padding-left: 15px;
    border-bottom: 1.5px solid #233464;
    padding-bottom: 2px;
  }

  :global(.bar) {
    width: 22px;
  }
  :global(.bar-cyan) {
    height: 42px;
    background: var(--cyan-neon);
    box-shadow: 0 0 8px rgba(0, 240, 255, 0.5);
  }
  :global(.bar-pink) {
    height: 60px;
    background: var(--pink-neon);
    box-shadow: 0 0 8px rgba(255, 0, 127, 0.5);
  }
  :global(.bar-yellow) {
    height: 48px;
    background: var(--yellow-accent);
    box-shadow: 0 0 8px rgba(255, 234, 0, 0.5);
  }

  /* Body Content */
  .mission-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .mission-title {
    font-size: 1.15rem;
    color: #ffffff;
    letter-spacing: -0.5px;
  }

  .mission-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #9cb1ce;
  }

  .mission-techs-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tech-chip {
    font-family: var(--font-pixel);
    font-size: 0.58rem;
    padding: 0.35rem 0.6rem;
    background: #040714;
    border: 1px solid #1a2952;
    color: #9cb1ce;
  }

  /* Footer bar */
  .mission-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(24, 37, 76, 0.8);
    padding-top: 1.1rem;
  }

  .footer-status {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--cyan-neon);
    letter-spacing: 0.5px;
  }

  .btn-open-mission {
    background: none;
    border: none;
    font-size: 0.65rem;
    color: var(--pink-neon);
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0.25rem 0.5rem;
  }

  .btn-open-mission:hover {
    color: #ffffff;
    text-shadow: 0 0 8px var(--pink-neon);
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .projects-showcase {
      margin-left: 0;
      min-height: 220px;
    }

    .missions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
