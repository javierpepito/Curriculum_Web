---
import { cvData } from '../data/cvData';
---

<section class="about-section" id="perfil">
  <div class="site-container">
    <!-- Section Header matching Image 2 -->
    <div class="section-header">
      <span class="badge-pink">REGISTRO DEL JUGADOR</span>
      <div class="section-title-wrap">
        <span class="section-number">01</span>
        <h2 class="section-title">SOBRE MÍ</h2>
        <div class="section-line"></div>
      </div>
    </div>

    <div class="about-grid">
      <!-- Left Column: Bio & Academic Info -->
      <div class="about-bio-wrap">
        <!-- Pixel Quotes Icon -->
        <div class="pixel-quote-icon">
          <svg width="28" height="20" viewBox="0 0 28 20" fill="none">
            <rect x="0" y="0" width="8" height="8" fill="#ff007f" />
            <rect x="6" y="6" width="6" height="8" fill="#ff007f" />
            <rect x="14" y="0" width="8" height="8" fill="#ff007f" />
            <rect x="20" y="6" width="6" height="8" fill="#ff007f" />
          </svg>
        </div>

        <p class="about-text">
          {cvData.personal.fullBio}
        </p>

        <!-- Academic & Experience Intel Cards -->
        <div class="intel-cards-row">
          <div class="intel-card">
            <div class="intel-header">
              <span class="intel-tag">EDUCACIÓN</span>
              <span class="intel-subtag">5° / 8 SEMESTRE</span>
            </div>
            <h4 class="intel-title">{cvData.personal.education.institution}</h4>
            <p class="intel-desc">
              {cvData.personal.education.degree} — {cvData.personal.education.campus}
            </p>
          </div>

          <div class="intel-card">
            <div class="intel-header">
              <span class="intel-tag">EXPERIENCIA</span>
              <span class="intel-subtag">DISPONIBLE</span>
            </div>
            <h4 class="intel-title">En Búsqueda de Práctica / Primer Empleo</h4>
            <p class="intel-desc">
              {cvData.personal.experience.description}
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Player Photo Card (Attributes hidden as requested) -->
      <div class="about-photo-wrap">
        <div class="photo-card cyber-card">
          <div class="panel-top-bar">
            <span class="panel-label">PILOTO // PERFIL</span>
            <span class="panel-status-online">
              <span class="status-dot"></span>
              ONLINE
            </span>
          </div>

          <div class="photo-frame">
            <div class="photo-corner-tl"></div>
            <div class="photo-corner-br"></div>
            <img 
              src="/foto2_curriculum.jpeg" 
              alt="Foto de Javier Méndez" 
              class="player-photo" 
            />
            <div class="scanline-overlay"></div>
          </div>

          <div class="photo-meta">
            <div class="meta-tag-row">
              <span class="badge-pink">ID: JAVIER MÉNDEZ</span>
              <span class="badge-cyan">NV. 05 INGENIERÍA</span>
            </div>
            <p class="photo-caption">
              Estudiante de Ingeniería en Informática. Enfocado en arquitectura de software, desarrollo frontend & backend y soluciones interactivas.
            </p>
          </div>
        </div>
      </div>

      {/* 
        ============================================================
        PANEL DE ATRIBUTOS (Temporalmente oculto/comentado a petición del usuario)
        Puedes descomentar este bloque cuando quieras volver a mostrarlos:
        ============================================================
        <div class="about-attributes-wrap">
          <div class="attributes-panel cyber-card">
            <div class="panel-top-bar">
              <span class="panel-label">ATRIBUTOS</span>
              <span class="panel-level">NV. 05</span>
            </div>

            <div class="stat-bars-list">
              {cvData.attributes.map((attr) => (
                <div class="stat-item">
                  <div class="stat-info">
                    <span class="stat-name">{attr.name}</span>
                    <span class="stat-percent">{attr.value}%</span>
                  </div>
                  <div class="stat-track">
                    <div class="stat-fill" style={`width: ${attr.value}%`}></div>
                  </div>
                </div>
              ))}
            </div>

            <div class="skills-tags-row">
              {cvData.personalSkills.map((skill) => (
                <span class="skill-tag-pill">{skill}</span>
              ))}
            </div>
          </div>
        </div>
      */}
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 4.5rem 0 5rem;
    position: relative;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: start;
  }

  /* Left Column */
  .about-bio-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .pixel-quote-icon {
    display: inline-block;
  }

  .about-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #cad8ec;
    font-family: var(--font-body);
  }

  /* Intel Cards */
  .intel-cards-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .intel-card {
    background: rgba(13, 20, 48, 0.6);
    border: 1px solid rgba(24, 37, 76, 0.8);
    border-left: 2px solid var(--cyan-neon);
    padding: 1rem 1.2rem;
  }

  .intel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .intel-tag {
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    color: var(--cyan-neon);
  }

  .intel-subtag {
    font-family: var(--font-pixel);
    font-size: 0.55rem;
    color: var(--pink-neon);
  }

  .intel-title {
    font-family: var(--font-tech);
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .intel-desc {
    font-size: 0.88rem;
    color: #8da2c0;
    line-height: 1.45;
  }

  /* Photo Card Styling */
  .about-photo-wrap {
    display: flex;
    justify-content: center;
  }

  .photo-card {
    width: 100%;
    max-width: 440px;
    padding: 1.75rem;
    box-shadow: 
      8px 8px 0px rgba(77, 16, 90, 0.4),
      0 0 25px rgba(0, 240, 255, 0.08);
  }

  .panel-status-online {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    color: var(--cyan-neon);
    letter-spacing: 1px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: var(--cyan-neon);
    box-shadow: 0 0 8px var(--cyan-neon);
    animation: blink 1.2s infinite;
  }

  .photo-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.05;
    overflow: hidden;
    border: 1px solid rgba(0, 240, 255, 0.4);
    background: #060918;
    margin-bottom: 1.25rem;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.6);
  }

  .player-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.4s ease;
  }

  .photo-card:hover .player-photo {
    transform: scale(1.03);
  }

  .photo-corner-tl {
    position: absolute;
    top: 0;
    left: 0;
    width: 14px;
    height: 14px;
    border-top: 3px solid var(--pink-neon);
    border-left: 3px solid var(--pink-neon);
    z-index: 2;
  }

  .photo-corner-br {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 14px;
    height: 14px;
    border-bottom: 3px solid var(--cyan-neon);
    border-right: 3px solid var(--cyan-neon);
    z-index: 2;
  }

  .scanline-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(18, 16, 16, 0) 50%, 
      rgba(0, 240, 255, 0.04) 50%
    );
    background-size: 100% 4px;
    pointer-events: none;
    z-index: 1;
  }

  .photo-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(24, 37, 76, 0.8);
  }

  .meta-tag-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .photo-caption {
    font-size: 0.92rem;
    color: #9cb1ce;
    line-height: 1.5;
  }

  /* Right Column: Panel */
  .attributes-panel {
    padding: 2.25rem 2rem;
    box-shadow: 
      8px 8px 0px rgba(77, 16, 90, 0.4),
      0 0 25px rgba(0, 240, 255, 0.08);
  }

  .panel-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .panel-label {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    color: var(--cyan-neon);
    letter-spacing: 1.5px;
  }

  .panel-level {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    color: var(--cyan-neon);
    letter-spacing: 1.5px;
  }

  .stat-bars-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
  }

  .stat-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .stat-name {
    font-family: var(--font-tech);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: #d1dff4;
  }

  .stat-percent {
    font-family: var(--font-pixel);
    font-size: 0.72rem;
    color: var(--cyan-neon);
  }

  .stat-track {
    height: 7px;
    background: #060918;
    border: 1px solid #1a2754;
    position: relative;
    overflow: hidden;
  }

  .stat-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--pink-neon) 0%, var(--cyan-neon) 100%);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.6);
    transition: width 1s ease-in-out;
  }

  /* Bottom Skill Tags */
  .skills-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(24, 37, 76, 0.8);
  }

  .skill-tag-pill {
    font-family: var(--font-pixel);
    font-size: 0.58rem;
    padding: 0.45rem 0.75rem;
    background: rgba(0, 240, 255, 0.04);
    border: 1px solid rgba(0, 240, 255, 0.4);
    color: #b5c7e4;
    letter-spacing: 1px;
    transition: all 0.2s ease;
  }

  .skill-tag-pill:hover {
    border-color: var(--cyan-neon);
    color: var(--cyan-neon);
    background: rgba(0, 240, 255, 0.12);
  }

  @media (max-width: 950px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .intel-cards-row {
      grid-template-columns: 1fr;
    }
  }
</style>
