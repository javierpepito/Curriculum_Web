---
import { cvData } from '../data/cvData';
---

<section class="about-section" id="perfil">
  <div class="site-container">
    <!-- Section Header matching Image 2 -->
    <div class="section-header">
      <span class="badge-pink">REGISTRO DEL JUGADOR</span>
      <div class="section-title-wrap">
        <span class="section-number">01</span>
        <h2 class="section-title">SOBRE MÍ</h2>
        <div class="section-line"></div>
      </div>
    </div>

    <div class="about-grid">
      <!-- Left Column: Bio & Academic Info -->
      <div class="about-bio-wrap">
        <!-- Pixel Quotes Icon -->
        <div class="pixel-quote-icon">
          <svg width="28" height="20" viewBox="0 0 28 20" fill="none">
            <rect x="0" y="0" width="8" height="8" fill="#ff007f" />
            <rect x="6" y="6" width="6" height="8" fill="#ff007f" />
            <rect x="14" y="0" width="8" height="8" fill="#ff007f" />
            <rect x="20" y="6" width="6" height="8" fill="#ff007f" />
          </svg>
        </div>

        <p class="about-text">
          {cvData.personal.fullBio}
        </p>

        <!-- Academic & Experience Intel Cards -->
        <div class="intel-cards-row">
          <div class="intel-card">
            <div class="intel-header">
              <span class="intel-tag">EDUCACIÓN</span>
              <span class="intel-subtag">5° / 8 SEMESTRE</span>
            </div>
            <h4 class="intel-title">{cvData.personal.education.institution}</h4>
            <p class="intel-desc">
              {cvData.personal.education.degree} — {cvData.personal.education.campus}
            </p>
          </div>

          <div class="intel-card">
            <div class="intel-header">
              <span class="intel-tag">EXPERIENCIA</span>
              <span class="intel-subtag">DISPONIBLE</span>
            </div>
            <h4 class="intel-title">En Búsqueda de Práctica / Primer Empleo</h4>
            <p class="intel-desc">
              {cvData.personal.experience.description}
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Player Attributes Panel matching Image 2 -->
      <div class="about-attributes-wrap">
        <div class="attributes-panel cyber-card">
          <div class="panel-top-bar">
            <span class="panel-label">ATRIBUTOS</span>
            <span class="panel-level">NV. 05</span>
          </div>

          <!-- Stat Bars -->
          <div class="stat-bars-list">
            {cvData.attributes.map((attr) => (
              <div class="stat-item">
                <div class="stat-info">
                  <span class="stat-name">{attr.name}</span>
                  <span class="stat-percent">{attr.value}%</span>
                </div>
                <div class="stat-track">
                  <div class="stat-fill" style={`width: ${attr.value}%`}></div>
                </div>
              </div>
            ))}
          </div>

          <!-- Bottom Skill Tags -->
          <div class="skills-tags-row">
            {cvData.personalSkills.map((skill) => (
              <span class="skill-tag-pill">{skill}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 4.5rem 0 5rem;
    position: relative;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: start;
  }

  /* Left Column */
  .about-bio-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .pixel-quote-icon {
    display: inline-block;
  }

  .about-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #cad8ec;
    font-family: var(--font-body);
  }

  /* Intel Cards */
  .intel-cards-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .intel-card {
    background: rgba(13, 20, 48, 0.6);
    border: 1px solid rgba(24, 37, 76, 0.8);
    border-left: 2px solid var(--cyan-neon);
    padding: 1rem 1.2rem;
  }

  .intel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .intel-tag {
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    color: var(--cyan-neon);
  }

  .intel-subtag {
    font-family: var(--font-pixel);
    font-size: 0.55rem;
    color: var(--pink-neon);
  }

  .intel-title {
    font-family: var(--font-tech);
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .intel-desc {
    font-size: 0.88rem;
    color: #8da2c0;
    line-height: 1.45;
  }

  /* Right Column: Panel */
  .attributes-panel {
    padding: 2.25rem 2rem;
    box-shadow: 
      8px 8px 0px rgba(77, 16, 90, 0.4),
      0 0 25px rgba(0, 240, 255, 0.08);
  }

  .panel-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .panel-label {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    color: var(--cyan-neon);
    letter-spacing: 1.5px;
  }

  .panel-level {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    color: var(--cyan-neon);
    letter-spacing: 1.5px;
  }

  .stat-bars-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
  }

  .stat-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .stat-name {
    font-family: var(--font-tech);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: #d1dff4;
  }

  .stat-percent {
    font-family: var(--font-pixel);
    font-size: 0.72rem;
    color: var(--cyan-neon);
  }

  .stat-track {
    height: 7px;
    background: #060918;
    border: 1px solid #1a2754;
    position: relative;
    overflow: hidden;
  }

  .stat-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--pink-neon) 0%, var(--cyan-neon) 100%);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.6);
    transition: width 1s ease-in-out;
  }

  /* Bottom Skill Tags */
  .skills-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(24, 37, 76, 0.8);
  }

  .skill-tag-pill {
    font-family: var(--font-pixel);
    font-size: 0.58rem;
    padding: 0.45rem 0.75rem;
    background: rgba(0, 240, 255, 0.04);
    border: 1px solid rgba(0, 240, 255, 0.4);
    color: #b5c7e4;
    letter-spacing: 1px;
    transition: all 0.2s ease;
  }

  .skill-tag-pill:hover {
    border-color: var(--cyan-neon);
    color: var(--cyan-neon);
    background: rgba(0, 240, 255, 0.12);
  }

  @media (max-width: 950px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .intel-cards-row {
      grid-template-columns: 1fr;
    }
  }
</style>
