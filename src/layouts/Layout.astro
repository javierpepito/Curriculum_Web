---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Javier Méndez // Portafolio & CV 16-Bit",
  description = "Curriculum web estilo Pixel Art 16-bit de Javier Méndez Sepúlveda, Estudiante de Ingeniería en Informática."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='%23060814'/><polygon points='8,2 14,8 8,14 2,8' fill='%23ff007f' stroke='%2300f0ff' stroke-width='1.5'/></svg>" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Press Start 2P, Chakra Petch & Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
