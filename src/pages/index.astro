---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Missions from '../components/Missions.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import MissionModal from '../components/MissionModal.astro';
import { cvData } from '../data/cvData';
---

<Layout 
  title={`${cvData.personal.name} // Portafolio Pixel Art 16-Bit`}
  description={cvData.personal.shortBio}
>
  <main class="page-wrapper">
    <Navbar />
    <Hero />
    <About />
    <Missions />
    <Contact />
    <Footer />

    <!-- Shared Mission Modal (Placed at root to avoid horizontal transform clipping) -->
    <MissionModal />
  </main>
</Layout>

<!-- GSAP Animation Script -->
<script>
  import '../scripts/gsap-animations.js';
</script>

<style>
  .page-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
  }

</style>
